{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Processor",
  "description": "Self-hosted RSS processing, semantic grouping, and grouped Atom feed publishing.",
  "colors": {
    "primary": "#0F172A",
    "light": "#94A3B8",
    "dark": "#64748B"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting started",
            "icon": "rocket",
            "pages": ["index", "quickstart", "screenshots"]
          },
          {
            "group": "Dashboard and processing",
            "icon": "gauge",
            "pages": [
              "dashboard",
              "processing/reader",
              "processing/processor-status",
              "processing/subscriptions",
              "processing/folders",
              "processing/folder-debug",
              "processing/feed-items",
              "processing/feed-item-detail",
              "processing/article-groups",
              "processing/atom-feeds",
              "processing/feed-preview",
              "processing/feed-preview-detail",
              "processing/statistics"
            ]
          },
          {
            "group": "Services and integrations",
            "icon": "server",
            "pages": [
              "services/fresh-rss",
              "services/ollama",
              "services/ollama-detail",
              "services/qdrant",
              "services/qdrant-detail",
              "services/websub"
            ]
          },
          {
            "group": "Administration",
            "icon": "users",
            "pages": [
              "administration/authentication",
              "administration/users",
              "administration/profile",
              "administration/jwt",
              "administration/posts"
            ]
          },
          {
            "group": "Reference",
            "icon": "book",
            "pages": [
              "reference/architecture",
              "reference/processing-pipeline",
              "reference/similarity-grouping",
              "reference/authentication",
              "reference/environment-variables",
              "reference/http-api",
              "reference/database",
              "reference/docker-hosting",
              "reference/development",
              "reference/internationalization",
              "reference/graphql-codegen",
              "reference/screenshots"
            ]
          }
        ]
      },
      {
        "tab": "GraphQL reference",
        "graphql": {
          "source": "schema.graphql",
          "directory": "graphql-reference"
        },
        "groups": [
          {
            "group": "Overview",
            "icon": "diagram-project",
            "pages": ["graphql/overview"]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub project",
          "href": "https://github.com/bludesign/processor",
          "icon": "github"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Issues",
        "href": "https://github.com/bludesign/processor/issues"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get started",
      "href": "/quickstart"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/bludesign/processor"
    },
    "links": [
      {
        "header": "© 2026 BluDesign, LLC",
        "items": [
          {
            "label": "Processor on GitHub",
            "href": "https://github.com/bludesign/processor"
          }
        ]
      }
    ]
  }
}
